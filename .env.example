# Database (Postgres — e.g. from Neon, Supabase, or Railway)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_study_companion"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Groq API (product AI — Tutor, Quiz generation, Grading, Recommendations, Concept extraction)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# Gemini API (embeddings only — semantic search / retrieval). Free tier: 100 requests/min,
# 1,000 requests/day, no billing account required. Get a free key at https://aistudio.google.com
GEMINI_API_KEY="AIza..."

# Local material storage path — used only when the S3-compatible vars below are unset.
# Fine for local dev; on any real deployment set the S3_* vars instead, since local disk
# doesn't survive redeploys and won't work with more than one server instance.
MATERIAL_STORAGE_DIR="./storage/materials"

# Optional: S3-compatible object storage for uploaded PDFs (recommended for production).
# Works with Backblaze B2 (10GB free, no card required — see docs/DEPLOYMENT.md),
# Cloudflare R2, Wasabi, MinIO, or AWS S3 itself. Leave all four unset to keep using
# local disk.
# S3_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
# S3_REGION="us-west-004"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME=""

# Shared secret for the /api/cron/process-jobs endpoint — used instead of a persistent
# worker process on serverless hosts like Vercel (see docs/DEPLOYMENT.md). Generate the
# same way as NEXTAUTH_SECRET. Not needed if you're running `npm run worker` instead.
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Daily circuit breaker on total AI spend (Groq + Gemini) across all users, in USD.
# New AI requests are refused once the last 24h of logged cost hits this. Set to 0
# to disable the cap entirely (not recommended in production).
DAILY_AI_SPEND_CAP_USD="10"
